# BPQ Portal example environment.
# Copy to .env and edit for your node before starting the service.

# Branding
SITE_NAME=BPQ Portal
SITE_TITLE=BPQ Portal
SITE_SUBTITLE=Packet Radio Messaging Interface
SITE_FOOTER_TEXT=Packet Radio Messaging
BRAND_SUBTITLE=BPQ Portal
BRAND_LOGO_PATH=/static/img/logo.png
BRAND_LOGO_ALT=BPQ Portal
CONTACT_FORM_URL=
CONTACT_FORM_LABEL=Contact Sysop / Request Account
NODE_CALLSIGN=MYNODE
PORTAL_TAGLINE=Sent via the BPQ Portal
APP_VERSION=v0.60

# Local database and web session.
# Use a long random SESSION_SECRET in production.
DATABASE_PATH=bpq_webmail.db
SESSION_SECRET=replace-with-a-long-random-secret

# BPQ services. BPQ_HOST is the default for all BPQ network services unless
# a service-specific host is set.
BPQ_HOST=127.0.0.1
BPQ_TELNET_HOST=127.0.0.1
BPQ_TELNET_PORT=8010
BPQ_POP3_HOST=127.0.0.1
BPQ_POP3_PORT=110
BPQ_SMTP_HOST=127.0.0.1
BPQ_SMTP_PORT=25

# Web bind settings used by install.sh and optional systemd service.
WEB_BIND_HOST=127.0.0.1
WEB_BIND_PORT=8088

# Compose command prefixes. Adjust if your BPQ BBS expects different verbs.
BPQ_COMPOSE_PRIVATE_COMMAND=sp
BPQ_COMPOSE_BULLETIN_COMMAND=sb
BPQ_COMPOSE_NTS_COMMAND=st
BPQ_COMPOSE_WINLINK_COMMAND=sp

# First-run admin setup.
# Recommended: leave AUTO_CREATE_ADMIN=false and create the first admin at
# /setup. Set FIRST_RUN_SETUP_TOKEN to require /setup?token=your-token.
FIRST_RUN_SETUP_ENABLED=true
FIRST_RUN_SETUP_TOKEN=
AUTO_CREATE_ADMIN=false

# Optional explicit auto-create admin. Only used when AUTO_CREATE_ADMIN=true,
# no admin exists, and the password is not an unsafe default.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_CALLSIGN=ADMIN
APP_ADMIN_BPQ_USER=ADMIN
APP_ADMIN_BPQ_PASSWORD=

# Privacy-conscious usage analytics.
ANALYTICS_ENABLED=true
ANALYTICS_IGNORE_PATHS=/static*,/favicon.ico,/health
ANALYTICS_IGNORE_BOTS=true
ANALYTICS_RETENTION_DAYS=365
