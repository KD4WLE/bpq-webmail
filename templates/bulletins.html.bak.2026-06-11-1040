{% extends "base.html" %}
{% block content %}

<h2>Bulletins</h2>
<p class="muted">Live bulletin list from LinBPQ BBS command <strong>LB</strong>.</p>

{% if error %}
  <div class="error">{{ error }}</div>
{% endif %}

{% if messages %}
<table>
  <tr>
    <th>Msg #</th>
    <th>Date</th>
    <th>Type</th>
    <th>Size</th>
    <th>Category</th>
    <th>Area</th>
    <th>From</th>
    <th>Subject</th>
  </tr>
  {% for m in messages %}
  <tr>
    <td>{{ m.id }}</td>
    <td>{{ m.date }}</td>
    <td>{{ m.type }}</td>
    <td>{{ m.size }}</td>
    <td>{{ m.category }}</td>
    <td>{{ m.area }}</td>
    <td>{{ m.from }}</td>
    <td>{{ m.subject }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
  <div class="card">
    <h3>No bulletins parsed</h3>
    <p class="muted">Raw BBS output is shown below for tuning.</p>
    <pre>{{ raw_output }}</pre>
  </div>
{% endif %}

{% endblock %}
